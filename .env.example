# Local development: path to the Firebase service account key file
# (download from Firebase Console → Project settings → Service accounts)
GOOGLE_APPLICATION_CREDENTIALS=./.config/firebase/big-feels-botanical-sa.json

# Hosted deployments (e.g. Vercel) can't read a key file. Set this instead,
# to the full JSON contents of the service account key, on one line.
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase storage bucket name
FIREBASE_STORAGE_BUCKET=big-feels-botanical.firebasestorage.app

# Firestore collection that indexes the gallery images
FIRESTORE_COLLECTION=gallery
