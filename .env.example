# Path to Firebase service account JSON (download from Firebase Console)
GOOGLE_APPLICATION_CREDENTIALS=./.config/firebase/big-feels-botanical-sa.json

# Firebase storage bucket name
FIREBASE_STORAGE_BUCKET=big-feels-botanical.firebasestorage.app

# Firestore collection name for gallery images
FIRESTORE_COLLECTION=gallery

# Public Firebase config (these can be public, add to .env.local for Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id